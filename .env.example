# Copy this file to .env.local (frontend) — never commit .env.local itself.

# URL of the FastAPI NER backend (medivision-backend/).
#   Local dev : http://localhost:8000
#   Render    : https://<your-service>.onrender.com
BACKEND_URL=http://localhost:8000

# Optional — enables the Gemini easy-read card (EN/TA/HI) in the built-in tier.
# The app works without it (raw label extracts + web evidence only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
